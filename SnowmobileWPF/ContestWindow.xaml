<Window x:Class="SnowmobileWPF.ContestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:SnowmobileWPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:ContestViewModel}"
        Title="Contest Settings"
        Height="380" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <TextBlock Text="Contest Settings" Style="{StaticResource HeaderText}" VerticalAlignment="Center" Margin="30,0"/>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}"
                Margin="25,15" Padding="25" CornerRadius="12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top content -->
                <StackPanel Grid.Row="0" VerticalAlignment="Top">

                    <!-- Status (left) + Start Contest (right) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Contest Status -->
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="CONTEST STATUS" Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>

                            <Border CornerRadius="10" Padding="12,5" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#94A3B8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentlyInContest}" Value="True">
                                                <Setter Property="Background" Value="#22C55E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontWeight="Bold" FontSize="11" Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="INACTIVE"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentlyInContest}" Value="True">
                                                    <Setter Property="Text" Value="ACTIVE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Visibility="{Binding CurrentlyInContest, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <!-- Vertical divider -->
                        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="0,4"/>

                        <!-- Right: Start Contest (hidden when active) -->
                        <StackPanel Grid.Column="2" Margin="15,0,0,0"
                                    Visibility="{Binding CurrentlyInContest, Converter={StaticResource InverseBooleanConverter}}">
                            <TextBlock Text="START CONTEST" Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="END DATE" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <DatePicker Name="EndDatePicker" SelectedDate="{Binding EndDate}"/>
                        </StackPanel>

                        <!-- Right: Active message + Stop button -->
                        <StackPanel Grid.Column="2" Margin="15,0,0,0"
                                    Visibility="{Binding CurrentlyInContest, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="A new contest cannot be started while one is in progress."
                                       FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Button Content="Stop Contest" Style="{StaticResource PrimaryButton}"
                                    Height="26" Width="140" MinWidth="0" HorizontalAlignment="Center"
                                    Command="{Binding StopCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Save / Cancel -->
                    <Grid Margin="0,12,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,0,0,0">
                            <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                    Height="26" Width="60" MinWidth="0" Margin="0,0,6,0"
                                    IsCancel="True" Command="{Binding CancelEditCommand}"/>
                            <Button Content="Save" Style="{StaticResource BlueButton}"
                                    Height="26" Width="60" MinWidth="0"
                                    IsDefault="True" Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>

                <!-- Management pinned to bottom -->
                <StackPanel Grid.Row="1">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,18"/>
                    <TextBlock Text="MANAGEMENT" Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Clear Contest Entries"
                                Style="{StaticResource SecondaryButton}" Height="28" MinWidth="0"
                                Command="{Binding ClearContestCommand}"/>
                        <Button Grid.Column="2" Content="Clear Ad Contest Entries"
                                Style="{StaticResource SecondaryButton}" Height="28" MinWidth="0"
                                Command="{Binding ClearAdContestCommand}"/>
                    </Grid>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
