<Window x:Class="SnowmobileWPF.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnowmobileWPF"
        mc:Ignorable="d"
        Title="Update Subscriber"
        Height="650"
        Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Name="HeaderLabel"
                       Text="Editing Subscriber"
                       Style="{StaticResource HeaderText}"
                       TextAlignment="Center"/>

            <!-- Name Fields -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="First Name"/>
                    <TextBox Name="FirstNameBox"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Last Name"/>
                    <TextBox Name="LastNameBox"/>
                </StackPanel>
            </Grid>

            <!-- Street Address -->
            <StackPanel Grid.Row="3" Margin="0,15,0,0">
                <TextBlock Text="Street Address"/>
                <TextBox Name="StreetAddressBox"/>
            </StackPanel>

            <!-- City / Region -->
            <Grid Grid.Row="4" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="City"/>
                    <TextBox Name="CityBox"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Region / State"/>
                    <TextBox Name="RegionBox"/>
                </StackPanel>
            </Grid>

            <!-- Postal / Country -->
            <Grid Grid.Row="5" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Postal Code"/>
                    <TextBox Name="PostalCodeBox"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Country"/>
                    <TextBox Name="CountryBox"/>
                </StackPanel>
            </Grid>

            <!-- Phone / Issues -->
            <Grid Grid.Row="6" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Phone Number"/>
                    <TextBox Name="PhoneNumberBox"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Issues Left"/>
                    <TextBox Name="IssuesLeftBox"/>
                </StackPanel>
            </Grid>

            <!-- Status Checkboxes -->
            <StackPanel Grid.Row="7" Margin="0,20,0,0">
                <TextBlock Text="Subscriber Status"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <WrapPanel>
                    <CheckBox Name="ActiveCheckBox" Content="Active" Margin="0,0,20,10"/>
                    <CheckBox Name="ContestCheckBox" Content="Contest" Margin="0,0,20,10"/>
                    <CheckBox Name="ManualMailCheckBox" Content="Manual Mail" Margin="0,0,20,10"/>
                    <CheckBox Name="CommercialCheckBox" Content="Commercial" Margin="0,0,20,10"/>
                </WrapPanel>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="9"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,25,0,0">
                <Button Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>
                <Button Name="UpdateButton"
                        Content="Update"
                        Style="{StaticResource PrimaryButton}"
                        Click="UpdateButton_Click"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Window>