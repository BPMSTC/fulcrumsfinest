<Window x:Class="SnowmobileWPF.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnowmobileWPF"
        mc:Ignorable="d"
        Title="Update subscriber" Height="500" Width="290"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Label Name="HeaderLabel"
               Content="Editing John Doe (VSCA: 1)"
               HorizontalAlignment="Left"
               Margin="10,0,0,0"
               VerticalAlignment="Center"
               Grid.ColumnSpan="2"/>

        <!-- First / Last Name -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="10,5">
            <Label Content="First Name"/>
            <TextBox Name="FirstNameBox"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,5">
            <Label Content="Last Name"/>
            <TextBox Name="LastNameBox"/>
        </StackPanel>

        <!-- Address -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="10,5">
            <Label Content="Street Address"/>
            <TextBox Name="StreetAddressBox"/>
        </StackPanel>

        <!-- City / Region -->
        <StackPanel Grid.Row="3" Grid.Column="0" Margin="10,5">
            <Label Content="City"/>
            <TextBox Name="CityBox"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,5">
            <Label Content="Region / State"/>
            <TextBox Name="RegionBox"/>
        </StackPanel>

        <!-- Postal Code / Country -->
        <StackPanel Grid.Row="4" Grid.Column="0" Margin="10,5">
            <Label Content="Postal Code"/>
            <TextBox Name="PostalCodeBox"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="1" Margin="10,5">
            <Label Content="Country"/>
            <TextBox Name="CountryBox"/>
        </StackPanel>

        <!-- Phone -->
        <StackPanel Grid.Row="5" Grid.Column="0" Margin="10,5">
            <Label Content="Phone Number"/>
            <TextBox Name="PhoneNumberBox"/>
        </StackPanel>
        
        <!-- Issues Left -->
        <StackPanel Grid.Row="5" Grid.Column="1" Margin="10,5">
            <Label Content="Issues left"/>
            <TextBox Name="IssuesLeftBox"/>
        </StackPanel>

        <!-- Checkboxes -->
        <Grid Grid.Row="6" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <CheckBox Name="ActiveCheckBox" Content="Active" Grid.Row="0" Margin="10,0,0,0" IsChecked="True"/>
            <CheckBox Name="ContestCheckBox" Content="Contest" Grid.Row="1" Margin="10,0,0,0"/>
            <CheckBox Name="ManualMailCheckBox" Content="Manual Mail" Grid.Row="2" Margin="10,0,0,0"/>
            <CheckBox Name="CommercialCheckBox" Content="Commercial" Grid.Row="3" Margin="10,0,0,0"/>
        </Grid>

        <!-- Buttons -->
        <Button Name="CancelButton"
                Grid.Row="7"
                Grid.Column="0"
                Content="Cancel"
                Margin="10"
                Click="CancelButton_Click"/>

        <Button Name="UpdateButton"
                Grid.Row="7"
                Grid.Column="1"
                Content="Update"
                Margin="10"
                Click="UpdateButton_Click"/>
    </Grid>
</Window>