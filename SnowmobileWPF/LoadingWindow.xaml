<Window x:Class="SnowmobileWPF.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnowmobileWPF"
        mc:Ignorable="d"
        Background="{StaticResource BackgroundBrush}"
        Title="Importing from CSV..." Height="120" Width="372" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="103*"/>
            <ColumnDefinition Width="269*"/>
        </Grid.ColumnDefinitions>
        <ProgressBar Name="ProgressBar" Margin="10,0,10,10" Height="39" VerticalAlignment="Bottom" Grid.ColumnSpan="2"/>
        <Label Name="VerboseProgress" Content="5% done" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
