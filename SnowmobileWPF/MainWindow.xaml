<Window x:Class="SnowmobileWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnowmobileWPF"
        mc:Ignorable="d"
        Title="VSCA Subscriber Manager" Height="600" Width="900"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,15">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="VSCA Subscriber Manager" Style="{StaticResource HeaderText}" VerticalAlignment="Center" Margin="0,0,25,0"/>

                    <Button Name="SearchButton" 
                            Content="Search"
                            Style="{StaticResource ToolbarButton}"
                            Width="100" Margin="0,0,10,0"
                            Click="SearchButton_Click"
                            IsDefault="True"/>

                    <Button Name="CreateDummyButton" 
                            Content="Create Dummy"
                            Style="{StaticResource ToolbarButton}"
                            Width="120" Margin="0,0,10,0"
                            Click="CreateDummyButton_Click"/>
                </StackPanel>

                <Button Name="DeleteButton" Content="Delete"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        Width="100" Height="32"
                        Click="DeleteButton_Click"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Background="{StaticResource CardBackgroundBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="5" 
                    Margin="0,0,15,0"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <ListBox Name="SubscriberList"
                             MouseDoubleClick="SubscriberList_MouseDoubleClick"
                             SelectionChanged="SubscriberList_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource PrimaryBrush}">
                    </ListBox>

                    <StackPanel Name="NoResultsMessage" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Center" 
                                Visibility="Collapsed">
                        <TextBlock Text="No results found" 
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Text="Try a different search" 
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,15">
                    <TextBlock Name="ViewingTitleLabel"
                               Text="Select a subscriber..."
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>

                    <Button Name="ClearSearchButton"
                            Content="Clear Search"
                            Style="{StaticResource SecondaryButton}"
                            Width="110" Height="30"
                            Visibility="Hidden"
                            DockPanel.Dock="Right"
                            Click="ClearSearchButton_Click"/>
                </DockPanel>

                <Border Name="DetailsPanel"
                        Grid.Row="1"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Padding="10"
                        Visibility="Collapsed"
                        Effect="{StaticResource CardShadow}">

                    <TabControl Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
                        <TabItem Header="Personal Details">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="ADDRESS" Style="{StaticResource FieldLabel}" Foreground="{StaticResource AccentBrush}"/>
                                    <Border Background="#F9FAFB" Padding="10" CornerRadius="5" Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Name="AddressLabel" FontWeight="Medium"/>
                                            <TextBlock Name="CSPLabel" />
                                            <TextBlock Name="CountryLabel" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="CONTACT" Style="{StaticResource FieldLabel}" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Name="PhoneLabel" Margin="0,0,0,15"/>

                                    <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}" Foreground="{StaticResource AccentBrush}"/>
                                    <UniformGrid Columns="2" Margin="0,5,0,0">
                                        <CheckBox Name="ActiveCheckBox" Content="Active" IsEnabled="False" Margin="0,0,0,8"/>
                                        <CheckBox Name="ContestCheckBox" Content="Contest" IsEnabled="False" Margin="0,0,0,8"/>
                                        <CheckBox Name="ManualMailCheckBox" Content="Manual Mail" IsEnabled="False" Margin="0,0,0,8"/>
                                        <CheckBox Name="CommercialCheckBox" Content="Commercial" IsEnabled="False" Margin="0,0,0,8"/>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Subscription">
                            <StackPanel>
                                <TextBlock Text="EXPIRATION" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Name="ExpirationLabel" Margin="0,0,0,15" FontSize="14"/>
                                <TextBlock Text="RENEWAL" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Name="RenewalLabel" Margin="0,0,0,15" FontSize="14"/>
                                <TextBlock Text="SOURCE" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Name="SourceLabel" FontSize="14"/>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Notes">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                    <Button Name="EditNotesButton" Content="Edit" Style="{StaticResource SecondaryButton}" Width="70" Margin="0,0,5,0" Click="EditNotesButton_Click"/>
                                    <Button Name="SaveNotesButton" Content="Save" Style="{StaticResource PrimaryButton}" Width="70" Margin="0,0,5,0" Visibility="Collapsed" Click="SaveNotesButton_Click"/>
                                    <Button Name="CancelNotesButton" Content="Cancel" Style="{StaticResource SecondaryButton}" Width="70" Visibility="Collapsed" Click="CancelNotesButton_Click"/>
                                </StackPanel>

                                <Border Grid.Row="1" Background="#F9FAFB" CornerRadius="5" Padding="10">
                                    <Grid>
                                        <TextBlock Name="NotesLabel" TextWrapping="Wrap"/>
                                        <TextBox Name="NotesTextBox" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Height="200"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>