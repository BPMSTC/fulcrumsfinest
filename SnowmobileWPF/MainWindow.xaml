<Window x:Class="SnowmobileWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnowmobileWPF"
        mc:Ignorable="d"
        Title="Subscribers" Height="520" Width="820"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Action Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,20">
            <Button Name="SearchButton"
                    Content="Search"
                    Style="{StaticResource SecondaryButton}"
                    Width="120"
                    Click="SearchButton_Click"
                    Margin="0,0,10,0"/>
            <Button Name="CreateDummyButton"
                    Content="Create Dummy"
                    Style="{StaticResource SecondaryButton}"
                    Width="120"
                    Click="CreateDummyButton_Click"
                    Margin="0,0,10,0"/>
            <Button Name="DeleteButton"
                    Content="Delete"
                    Style="{StaticResource SecondaryButton}"
                    Width="120"
                    Click="DeleteButton_Click"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Subscriber List -->
            <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="5" Background="White" Padding="5" Margin="0,0,15,0">
                <ListBox Name="SubscriberList"
                         MouseDoubleClick="SubscriberList_MouseDoubleClick"
                         SelectionChanged="SubscriberList_SelectionChanged"
                         Background="White"
                         BorderThickness="0"
                         Foreground="{StaticResource PrimaryBrush}">
                </ListBox>
            </Border>

            <!-- Details Panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Centered Title and Clear Search -->
                <DockPanel Margin="0,0,0,15">
                    <Label Name="ViewingTitleLabel"
                           Content="Select a subscriber..."
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"
                           DockPanel.Dock="Left"/>
                    <Button Name="ClearSearchButton"
                            Content="Clear Search"
                            Style="{StaticResource SecondaryButton}"
                            Width="120"
                            Visibility="Hidden"
                            DockPanel.Dock="Right"
                            Click="ClearSearchButton_Click"/>
                </DockPanel>

                <!-- Details Panel -->
                <Border Name="DetailsPanel"
                        Grid.Row="1"
                        Background="White"
                        CornerRadius="5"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="1"
                        Padding="15"
                        Visibility="Collapsed">
                    <Grid>
                        <TabControl Background="White">
                            <!-- Personal Details Tab -->
                            <TabItem Header="Personal Details">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                                    <StackPanel>
                                        <!-- Address -->
                                        <TextBlock Text="Address" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,5"/>
                                        <TextBlock Name="AddressLabel" Text="" Margin="10,0,0,0"/>
                                        <TextBlock Name="CSPLabel" Text="" Margin="10,0,0,0"/>
                                        <TextBlock Name="CountryLabel" Text="" Margin="10,0,0,10"/>

                                        <!-- Contact -->
                                        <TextBlock Text="Contact" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,5"/>
                                        <TextBlock Name="PhoneLabel" Text="" Margin="10,0,0,10"/>

                                        <!-- Status -->
                                        <TextBlock Text="Subscriber Status" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,5"/>
                                        <UniformGrid Columns="2" Rows="2" Margin="10,0,0,0">
                                            <CheckBox Name="ActiveCheckBox" Content="Active" IsEnabled="False" Margin="0,0,20,10"/>
                                            <CheckBox Name="ContestCheckBox" Content="Contest" IsEnabled="False" Margin="0,0,20,10"/>
                                            <CheckBox Name="ManualMailCheckBox" Content="Manual Mail" IsEnabled="False" Margin="0,0,20,10"/>
                                            <CheckBox Name="CommercialCheckBox" Content="Commercial" IsEnabled="False" Margin="0,0,20,10"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Subscription Tab -->
                            <TabItem Header="Subscription">
                                <StackPanel Margin="10">
                                    <TextBlock Name="ExpirationLabel" Text="" Margin="0,0,0,5"/>
                                    <TextBlock Name="RenewalLabel" Text="" Margin="0,0,0,5"/>
                                    <TextBlock Name="SourceLabel" Text=""/>
                                </StackPanel>
                            </TabItem>

                            <!-- Notes Tab -->
                            <TabItem Header="Notes">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,0,10">
                                        <Button Name="EditNotesButton"
                                                Content="Edit"
                                                Style="{StaticResource SecondaryButton}"
                                                Width="80"
                                                Margin="0,0,10,0"
                                                Click="EditNotesButton_Click"/>

                                        <Button Name="SaveNotesButton"
                                                Content="Save"
                                                Style="{StaticResource SecondaryButton}"
                                                Width="80"
                                                Margin="0,0,10,0"
                                                Visibility="Collapsed"
                                                Click="SaveNotesButton_Click"/>

                                        <Button Name="CancelNotesButton"
                                                Content="Cancel"
                                                Style="{StaticResource SecondaryButton}"
                                                Width="80"
                                                Visibility="Collapsed"
                                                Click="CancelNotesButton_Click"/>
                                    </StackPanel>

                                    <!-- Read-only view -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Name="NotesLabel"
                                                   Text=""
                                                   TextWrapping="Wrap"
                                                   Height="Auto"/>
                                    </ScrollViewer>

                                    <!-- Edit view -->
                                    <TextBox Name="NotesTextBox"
                                             Grid.Row="1"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Visibility="Collapsed"
                                             Height="Auto"/>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>