<Window x:Class="SnowmobileWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnowmobileWPF"
        mc:Ignorable="d"
        Title="VSCA Subscriber Manager" Height="690" Width="1200"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding EscapeCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,15">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="VSCA Subscriber Manager" Style="{StaticResource HeaderText}" VerticalAlignment="Center" Margin="0,0,25,0"/>
                    
                    <Button Name="SearchButton" Content="Search" Style="{StaticResource ToolbarButton}" Width="100" Margin="0,0,10,0" Click="SearchButton_Click" IsDefault="True"/>
                    <Button Name="CreateButton" Content="Create New" Style="{StaticResource ToolbarButton}" Width="120" Margin="0,0,10,0" Command="{Binding CreateCommand}"/>
                    <Button Name="ImportButton" Content="Import" Style="{StaticResource ToolbarButton}" Width="120" Margin="0,0,10,0" Command="{Binding ImportCommand}"/>
                    <Button Name="ExportButton" Content="Export" Style="{StaticResource ToolbarButton}" Width="120" Margin="0,0,10,0" Command="{Binding ExportCommand}"/>
                    <Button Name="ContestButton" 
                        Content="Contest"
                        Style="{StaticResource ToolbarButton}"
                        Width="100" Margin="0,0,10,0"
                        Command="{Binding ContestCommand}" Loaded="ContestButton_Loaded">
                    </Button>
                    <Button Content="Clear Search" 
                                Style="{StaticResource ToolbarButton}" 
                                Width="120" 
                                Margin="0,0,10,0" 
                                Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <Button Name="DeleteButton" Content="Delete" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Width="100" Height="32" Command="{Binding DeleteCommand}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,0,15,0" Effect="{StaticResource CardShadow}">
                <Grid>
                    <ListBox Name="SubscriberList" ItemsSource="{Binding Subscribers}" SelectedItem="{Binding SelectedSubscriber}" MouseDoubleClick="SubscriberList_MouseDoubleClick" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="No subscribers found." 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center" 
                               Foreground="{StaticResource MutedTextBrush}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,15" Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ViewingTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>

                        <Border CornerRadius="12" Padding="10,3" Margin="15,5,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#94A3B8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSubscriber.Active}" Value="True">
                                            <Setter Property="Background" Value="#22C55E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontWeight="Bold" FontSize="10" Foreground="White">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="INACTIVE"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSubscriber.Active}" Value="True">
                                                <Setter Property="Text" Value="ACTIVE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20" Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVis}}" Effect="{StaticResource CardShadow}">
                    <TabControl Background="Transparent" BorderThickness="0">
                        <TabItem Header="Personal Details">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,25">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="ADDRESS" Style="{StaticResource AccentFieldLabel}"/>
                                            <Border Background="#F8FAFC" Padding="12" CornerRadius="6" BorderBrush="#F1F5F9" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SelectedSubscriber.Address.Street}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap">
                                                        <Run Text="{Binding SelectedSubscriber.Address.City}"/><Run Text=","/>
                                                        <Run Text="{Binding SelectedSubscriber.Address.Region}"/>
                                                        <Run Text="{Binding SelectedSubscriber.Address.PostalCode}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding SelectedSubscriber.Address.Country}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="CONTACT" Style="{StaticResource AccentFieldLabel}"/>
                                            <Border Background="#F8FAFC" Padding="12" CornerRadius="6" BorderBrush="#F1F5F9" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SelectedSubscriber.PhoneDisplay}" FontWeight="Medium" FontSize="14" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding SelectedSubscriber.EmailDisplay}" FontWeight="Medium" FontSize="14" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Separator Background="#F1F5F9" Margin="0,0,0,20"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="SUBSCRIPTION DETAILS" Style="{StaticResource AccentFieldLabel}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                                            <Button Content="Edit" Command="{Binding EditSubscriptionCommand}" Width="70" Margin="0,0,5,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditingSubscription}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Renew" Style="{StaticResource SecondaryButton}" Visibility="{Binding IsEditingSubscription, Converter={StaticResource BoolToVis}}" Width="70" Margin="0,0,5,0" HorizontalAlignment="Left" Command="{Binding RenewCommand}" Height="30"/>
                                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Height="30" Width="70" Margin="0,0,5,0" Command="{Binding SaveSubscriptionCommand}" Visibility="{Binding IsEditingSubscription, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="30" Width="70" Command="{Binding CancelSubscriptionCommand}" Visibility="{Binding IsEditingSubscription, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="#F8FAFC" Padding="15" CornerRadius="6" BorderBrush="#F1F5F9" BorderThickness="1" Margin="0,0,10,25">
                                        <UniformGrid Columns="5">
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="SOURCE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>

                                                <ComboBox Name="SourceComboBox"
                                                  SelectedItem="{Binding Source}"
                                                  Height="26"
                                                  Visibility="{Binding IsEditingSubscription, Converter={StaticResource BoolToVis}}"
                                                  Margin="0,0,0,5"/>

                                                <TextBlock Text="{Binding Source}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                                    Visibility="{Binding IsEditingSubscription, Converter={StaticResource InverseBooleanConverter}}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="LAST RENEWED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>

                                                <DatePicker SelectedDate="{Binding RenewDate}"
                                                    Visibility="{Binding IsEditingSubscription, Converter={StaticResource BoolToVis}}"
                                                    Margin="0,0,0,5"/>

                                                <TextBlock Text="{Binding RenewDate, StringFormat='\{0:d\}'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                                    Visibility="{Binding IsEditingSubscription, Converter={StaticResource InverseBooleanConverter}}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="EXPIRES ON" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>

                                                <DatePicker SelectedDate="{Binding ExpDate}"
                                                            Visibility="{Binding IsEditingSubscription, Converter={StaticResource BoolToVis}}"
                                                            Margin="0,0,0,5"/>

                                                <TextBlock Text="{Binding ExpDate, StringFormat='\{0:d\}'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                                           Visibility="{Binding IsEditingSubscription, Converter={StaticResource InverseBooleanConverter}}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="ISSUES REMAINING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>

                                                <TextBox Text="{Binding IssuesRemaining, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                         Height="26"
                                                         VerticalContentAlignment="Center"
                                                         Padding="5,0"
                                                         PreviewTextInput="NumberValidationTextBox"
                                                         Visibility="{Binding IsEditingSubscription, Converter={StaticResource BoolToVis}}"
                                                         Margin="0,0,0,5"/>

                                                <TextBlock Text="{Binding IssuesRemaining}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           Height="26"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsEditingSubscription, Converter={StaticResource InverseBooleanConverter}}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="FINAL ISSUE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5">
                                                    <TextBlock.ToolTip>
                                                        <ToolTip Content="This is the last issue the subscriber is eligible for if they do not renew."></ToolTip>
                                                    </TextBlock.ToolTip>
                                                </TextBlock>
                                                <TextBlock Text="{Binding FinalIssue}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>

                                    <Separator Background="#F1F5F9" Margin="0,0,0,20"/>
                                    <TextBlock Text="ACCOUNT FLAGS" Style="{StaticResource AccentFieldLabel}"/>
                                    <Border Background="#F8FAFC" Padding="12,10" CornerRadius="6" BorderBrush="#F1F5F9" BorderThickness="1" Margin="0,5,10,20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="CONTEST" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Text="MAILING" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                            <Border Grid.Column="2" Grid.RowSpan="2" Background="#E2E8F0" Margin="8,0"/>

                                            <CheckBox Grid.Row="1" Grid.Column="0" Content="Contest" IsChecked="{Binding SelectedSubscriber.Contest}" IsEnabled="False" Margin="5,3" HorizontalAlignment="Center"/>
                                            <CheckBox Grid.Row="1" Grid.Column="1" Content="Ad Contest" IsChecked="{Binding SelectedSubscriber.AdContest}" IsEnabled="False" Margin="5,3" HorizontalAlignment="Center"/>
                                            <CheckBox Grid.Row="1" Grid.Column="3" Content="Manual Mail" IsChecked="{Binding SelectedSubscriber.ManualMail}" IsEnabled="False" Margin="5,3" HorizontalAlignment="Center"/>
                                            <CheckBox Grid.Row="1" Grid.Column="4" Content="Commercial" IsChecked="{Binding SelectedSubscriber.Commercial}" IsEnabled="False" Margin="5,3" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Notes">
                            <Grid Margin="0,15,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,12">
                                    <Button Content="Edit" Command="{Binding EditNotesCommand}" Click="EditNotesButton_Click" Width="70" Margin="0,0,5,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingNotes}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Height="30" Width="70" Margin="0,0,5,0" Command="{Binding SaveNotesCommand}" Visibility="{Binding IsEditingNotes, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="30" Width="70" Command="{Binding CancelNotesCommand}" Visibility="{Binding IsEditingNotes, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="6" BorderBrush="#F1F5F9" BorderThickness="1" Padding="12">
                                    <Grid>
                                        <TextBlock Text="{Binding NotesText}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NotesLabelStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditingNotes}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox x:Name="NotesTextBox" Text="{Binding NotesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NotesEditStyle}" Visibility="{Binding IsEditingNotes, Converter={StaticResource BoolToVis}}" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Stretch" MinHeight="200"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>